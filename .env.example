# Kandrop — environment variables.
# Development: copy this file to .env.local. Production: set them in the host's environment.
# Never commit real values. Everything is validated in src/server/config/env.ts.
# (NODE_ENV is set by Next.js itself: `next dev` = development, `next start` = production.)

# ── Required in production ────────────────────────────────────────────────────────────────

# Secret that signs session JWTs (min 32 chars). In production the app refuses every request that
# needs it while it is missing. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL of this app, with no trailing slash (e.g. https://app.example.ao).
# It is used for the URL the payment provider calls back (/api/webhooks/multicaixa) and for links
# the server builds (affiliate links). Leave it empty in development: it falls back to
# http://127.0.0.1:$PORT (webhook) and to the request's own origin (links).
APP_URL=

# ── Payments ──────────────────────────────────────────────────────────────────────────────

# `sandbox` SIMULATES Multicaixa Express, Unitel Money and cards: no real money moves, and a
# "Payment complete" screen means nothing. `live` is refused until a real payment provider is
# integrated, so today the app CANNOT take real payments in either mode.
PAYMENTS_MODE=sandbox

# HMAC-SHA256 secret that signs the Multicaixa webhook (min 32 chars). Empty in sandbox = a random
# secret per process, which only works with ONE instance. Set it when running more than one
# instance, and always once a real provider is integrated. Generate: openssl rand -hex 32
MULTICAIXA_WEBHOOK_SECRET=

# ── Supabase (database) ───────────────────────────────────────────────────────────────────
# REQUIRED: every repository reads and writes through Supabase. Apply supabase/migrations/*.sql to
# the project first (Supabase dashboard → SQL editor, or `supabase db push`), then fill these in
# (Project Settings → API).

# Project URL and anon key. Both are PUBLIC by design (they end up in the browser bundle);
# what the anon key can do is limited by Row Level Security, so enable RLS on every table.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security: server only, never prefix it with NEXT_PUBLIC_, never commit it.
# Kandrop's login is a custom session (not Supabase Auth), so server-side repositories use this key
# and filter every query by store_id themselves.
SUPABASE_SERVICE_ROLE_KEY=

# ── Operator console (/admin) ─────────────────────────────────────────────────────────────

# The e-mails (comma-separated) of the accounts that may open /admin. Empty = nobody can: the pages
# answer 404. In development, AUTH_DEV_BYPASS also opens it. Never put a shared mailbox here.
ADMIN_EMAILS=

# ── Bank transfer (paying a Kandrop plan by transfer) ─────────────────────────────────────

# Where the money goes and who receives the proof. Set ALL of BANK, ACCOUNT, IBAN and SUPPORT_WHATSAPP
# to offer "Bank transfer" in production; with none set it is offered only in sandbox mode, showing
# clearly-labelled EXAMPLE details (never real ones: a payer would send real money to them). If they
# are set but invalid the method is switched off and an error is logged.
BANK_TRANSFER_BANK=
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_ACCOUNT=
# Angolan IBAN: AO + 2 check digits + 21 digits (spaces allowed); the check digits are verified.
BANK_TRANSFER_IBAN=
# Read by the shopper's order page (/pedido/...): each one is shown only when set and valid, none is invented.
# The bank name and the holder may also be given as BANK_TRANSFER_BANK_NAME / BANK_TRANSFER_ACCOUNT_NAME.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
# Optional: 8 or 11 characters.
BANK_TRANSFER_BIC_SWIFT=
# 9-digit Angolan number that receives the proofs (no +244).
SUPPORT_WHATSAPP=

# The support inbox shown on the Support page (the WhatsApp number shown there is SUPPORT_WHATSAPP above).
# Both fall back to the values in src/server/modules/support/contacts.ts.
SUPPORT_EMAIL=

# A transfer never activates a plan by itself: it waits for someone at Kandrop to confirm the money
# arrived, with `POST /api/admin/transfers/<reference>/confirm` and `Authorization: Bearer <this>`
# (min 32 chars; openssl rand -hex 32). Unset = that endpoint does not exist. In sandbox mode the
# validation is simulated (about 20 s), so this is only needed for real transfers.
ADMIN_API_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────────────────

# Port the server listens on (Next.js default: 3000). Also used to build the sandbox webhook URL
# when APP_URL is empty.
PORT=3000

# ── Development / demo only: MUST stay false in production ────────────────────────────────

# Skip login and act as a demo merchant. The app throws at start-up in production if this is true.
AUTH_DEV_BYPASS=false

# Seeds demo data into EVERY store (orders, deliveries, affiliates, academy progress) and publishes
# fake real-time events so the dashboard moves. Great for a demo, wrong for real merchants: the app
# logs a warning when it is on in production.
KANDROP_DEMO_EVENTS=false

# AES-256 key for IBANs and tax numbers at rest: `openssl rand -base64 32`. Back it up apart from the
# database: without it the encrypted values cannot be read. Unset = stored unencrypted (with a warning).
DATA_ENCRYPTION_KEY=

# THE WAITLIST SWITCH. NEXT_PUBLIC_WAITLIST_MODE=true: the home page and the marketing pages show the waitlist (/waitlist, built into this app);
# =false: they show the official site and /waitlist redirects home (the day of the launch: set false and redeploy; it is read at BUILD time).
# Always reachable in both modes: /api, sign-in/sign-up, /admin, /dashboard, /checkout, /fornecedor, the stores and the order pages.
# Unset: falls back to the old rule (on in production unless COMING_SOON=false), so a deploy never flips the state by surprise.
NEXT_PUBLIC_WAITLIST_MODE=true
COMING_SOON=
# Optional: open /api/preview?key=<this key> to see the real site while the waitlist is on (private cookie, 30 days).
COMING_SOON_BYPASS_KEY=

# The waitlist itself (src/waitlist). Server-only values are never sent to the browser.
# Countdown target (default 2026-11-30T23:00:00Z) and the contacts shown on the waitlist.
NEXT_PUBLIC_LAUNCH_AT=2026-11-30T23:00:00Z
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_PRIVACY_EMAIL=suport@kandrop.com
# waitlist (default) | launched: the waitlist's own countdown / launched screens.
LAUNCH_MODE=waitlist
# n8n webhooks that store the sign-ups (production URL, not /webhook-test/) and the optional read-only ones.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_STATUS_URL=
N8N_STATS_URL=
# Sign-up rate limit and the salt that hashes the IP.
RATE_LIMIT_MAX_PER_HOUR=5
RATE_LIMIT_WINDOW_MS=3600000
IP_HASH_SALT=

# REQUIRED in production. The public address the merchant's promotion links are built on (no trailing slash).
# Unset or invalid = the address the request came to (the app keeps working, but links may point at a preview URL).
PUBLIC_SITE_URL=https://www.kandrop.com

# Meta (Facebook) Pixel id for paid-traffic campaigns: digits only. Unset = no pixel, nothing is loaded. Read at BUILD
# time (NEXT_PUBLIC_), so redeploy after changing it. Events: PageView (all pages), InitiateCheckout (checkout form),
# Purchase (the order confirmation page, once per order).
NEXT_PUBLIC_META_PIXEL_ID=

# Daily subscriptions job (vercel.json cron -> /api/cron/subscriptions): 3-day renewal reminders and switching off expired accounts.
# Vercel Cron sends this value as "Authorization: Bearer <value>". Use 16+ random characters. Unset = the job refuses to run.
CRON_SECRET=

# Transactional e-mail via Resend (order confirmation sent to the customer after checkout). RESEND_API_KEY unset = no
# e-mail is sent (checkout is unaffected). EMAIL_FROM must be on a domain you verified in Resend; unset = Resend's test
# sender (it only delivers to your own Resend account address).
RESEND_API_KEY=
EMAIL_FROM=

# Web Push (browser notifications for new sales). Generate the pair with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact. NEXT_PUBLIC_VAPID_PUBLIC_KEY is the SAME public key (read at build time).
# Without the pair, "Ativar notificações" is hidden and nothing is sent.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:suporte@kandrop.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# External alerts (optional, independent). Each URL receives a JSON POST.
# Admin Telegram: body { text, chat_id? }. Use https://api.telegram.org/bot<TOKEN>/sendMessage with ADMIN_TELEGRAM_CHAT_ID.
ADMIN_TELEGRAM_WEBHOOK=
ADMIN_TELEGRAM_CHAT_ID=
# Merchant WhatsApp gateway: body { to, message } (to = the merchant's number, 244 + 9 digits), optional Bearer token.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
