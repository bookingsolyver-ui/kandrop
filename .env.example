# Kandrop — environment variables.
# Development: copy this file to .env.local. Production: set them in the host's environment.
# Never commit real values. Everything is validated in src/server/config/env.ts.
# (NODE_ENV is set by Next.js itself: `next dev` = development, `next start` = production.)

# ── Required in production ────────────────────────────────────────────────────────────────

# Secret that signs session JWTs (min 32 chars). In production the app refuses every request that
# needs it while it is missing. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Public base URL of this app, with no trailing slash (e.g. https://app.example.ao).
# It is used for the URL the payment provider calls back (/api/webhooks/multicaixa) and for links
# the server builds (affiliate links). Leave it empty in development: it falls back to
# http://127.0.0.1:$PORT (webhook) and to the request's own origin (links).
APP_URL=

# ── Payments ──────────────────────────────────────────────────────────────────────────────

# `sandbox` SIMULATES Multicaixa Express, Unitel Money and cards: no real money moves, and a
# "Payment complete" screen means nothing. `live` is refused until a real payment provider is
# integrated, so today the app CANNOT take real payments in either mode.
PAYMENTS_MODE=sandbox

# HMAC-SHA256 secret that signs the Multicaixa webhook (min 32 chars). Empty in sandbox = a random
# secret per process, which only works with ONE instance. Set it when running more than one
# instance, and always once a real provider is integrated. Generate: openssl rand -hex 32
MULTICAIXA_WEBHOOK_SECRET=

# ── Server ────────────────────────────────────────────────────────────────────────────────

# Port the server listens on (Next.js default: 3000). Also used to build the sandbox webhook URL
# when APP_URL is empty.
PORT=3000

# ── Development / demo only: MUST stay false in production ────────────────────────────────

# Skip login and act as a demo merchant. The app throws at start-up in production if this is true.
AUTH_DEV_BYPASS=false

# Seeds demo data into EVERY store (orders, deliveries, affiliates, academy progress) and publishes
# fake real-time events so the dashboard moves. Great for a demo, wrong for real merchants: the app
# logs a warning when it is on in production.
KANDROP_DEMO_EVENTS=false
